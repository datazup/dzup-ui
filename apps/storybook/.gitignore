# Storybook build output
storybook-static/

# Generated playground assets — rebuilt from workspace source by
# scripts/build-playground.mjs before every `storybook dev` / `build`.
public/playground/

# Generated "What's New" / Releases data — rebuilt from CHANGELOG.md + .changeset
# by scripts/build-releases.mjs before every `storybook dev` / `build`.
stories/_data/releases.generated.ts

# Served copies of the generated component-API llms docs. Since TASK-N2-A3 the
# SOURCE of truth is committed at packages/core/docs/llms{,-full}.txt (rendered
# from component-meta.json by `yarn generate:llms` and gated by
# `yarn validate:llms`); scripts/build-llms.mjs only copies it here before every
# `storybook dev` / `build`. These two stay ignored because they are copies.
public/llms.txt
public/llms-full.txt
