{
  "name": "@dzup-ui/storybook",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Storybook for dzup-ui component library",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "build:playground": "node scripts/build-playground.mjs",
    "build:releases": "node scripts/build-releases.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "build:playground-snippets": "node scripts/build-playground-snippets.mjs",
    "build:counts": "yarn workspace @dzup-ui/landing build:counts",
    "validate:llms": "node scripts/validate-llms.mjs",
    "verify:repl": "node scripts/verify-repl.mjs",
    "check:mdx-links": "node scripts/check-mdx-links.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "yarn build:counts && yarn build:releases && yarn build:playground && yarn build:llms && yarn build:playground-snippets && storybook build && node scripts/check-theme-recipe-static.mjs && yarn check:size",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:coverage": "vitest run --project=storybook --coverage",
    "test-storybook:ci": "vitest run --project=storybook --coverage --reporter=default --reporter=junit --reporter=json --outputFile.junit=a11y-report/junit.xml --outputFile.json=a11y-report/a11y-results.json",
    "chromatic": "chromatic --build-script-name build --exit-zero-on-changes",
    "check:size": "node scripts/check-bundle-size.mjs --max-mb 25"
  },
  "dependencies": {
    "@dzup-ui/core": "workspace:*",
    "@dzup-ui/tokens": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "@vue/repl": "^4.6.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.1",
    "@storybook/addon-docs": "^10.5.1",
    "@storybook/addon-vitest": "^10.5.1",
    "@storybook/vue3-vite": "^10.5.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/browser": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "chromatic": "^11.0.0",
    "playwright": "^1.49.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.6",
    "vue": "^3.5.13"
  }
}
