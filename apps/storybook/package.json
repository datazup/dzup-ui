{
  "name": "@dzup-ui/storybook",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Storybook for dzup-ui component library",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "build:playground": "node scripts/build-playground.mjs",
    "build:releases": "node scripts/build-releases.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "dev": "yarn build:releases && yarn build:playground && yarn build:llms && storybook dev -p 6006",
    "build": "yarn build:releases && yarn build:playground && yarn build:llms && storybook build",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:coverage": "vitest run --project=storybook --coverage",
    "test-storybook:ci": "vitest run --project=storybook --coverage --reporter=default --reporter=junit --reporter=json --outputFile.junit=a11y-report/junit.xml --outputFile.json=a11y-report/a11y-results.json",
    "chromatic": "chromatic --build-script-name build --exit-zero-on-changes",
    "check:size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@dzup-ui/core": "workspace:*",
    "@dzup-ui/tokens": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "@vue/repl": "^4.6.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.4",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/addon-themes": "^10.3.4",
    "@storybook/addon-vitest": "^10.3.4",
    "@storybook/vue3-vite": "^10.3.4",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/browser": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "chromatic": "^11.0.0",
    "playwright": "^1.49.0",
    "storybook": "^10.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.6",
    "vue": "^3.5.13"
  }
}
