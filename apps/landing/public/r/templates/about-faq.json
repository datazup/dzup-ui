{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "about-faq",
  "type": "registry:block",
  "title": "About & FAQ",
  "description": "A company page — a mission hero with headline stats, a founding-to-today story timeline, values cards, a leadership grid and an FAQ accordion.",
