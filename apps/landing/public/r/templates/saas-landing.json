{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "saas-landing",
  "type": "registry:block",
  "title": "SaaS Landing",
  "description": "A conversion-ready marketing page — hero, feature grid, testimonial carousel, pricing teaser and an FAQ.",
  "categories": [
    "marketing"
