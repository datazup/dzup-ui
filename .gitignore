# dependencies
node_modules/

# yarn local state
.yarn/install-state.gz

# build outputs
coverage/
dist/
storybook-static/
playwright-report/
test-results/
a11y-report/

# TASK-OSS-P5-05 scratch: `perf:capture` builds a throwaway Vite fixture per
# Tier C/D export in .perf-export-size/ and streams raw samples through
# .perf-samples.ndjson. Both are removed in a `finally`; ignored so an
# interrupted capture does not leave a dirty worktree behind it.
.perf-export-size/
.perf-samples.ndjson

# derived on every landing build from the committed WebP thumbnails (build-og-images.ts)
apps/landing/public/og-templates/

# Storybook's copy of the derived counts — `storybook build` runs build:counts
# itself, so this is always regenerated before anything reads it. The LANDING
# copy (apps/landing/src/generated/counts.ts) is deliberately COMMITTED instead:
# specs import it under a bare `yarn test`, with no build step to write it first.
# See apps/landing/src/generated/README.md.
apps/storybook/stories/_data/counts.generated.ts

# source-adjacent TypeScript emit
packages/core/src/providers/*.js
packages/core/src/providers/*.js.map
packages/core/src/providers/*.d.ts

# caches
*.tsbuildinfo

# debug logs — a 0-byte apps/storybook/debug-storybook.log rode along in the repo
# for months because nothing ignored this (TASK-FREE-12)
*.log

# env
.env
.env.*
!.env.example

# IDE/editor
.idea/
.vscode/

# local AI/dev tooling
.serena/

# OS
.DS_Store
Thumbs.db

# Local agent worktrees
.worktrees/
.claude/worktrees/
