FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare yarn@4.16.0 --activate

WORKDIR /workspace/ui/dzup-ui
COPY ui/dzup-ui/ ./

ARG UI_WORKSPACE
ARG UI_DIST_PATH

RUN test -n "$UI_WORKSPACE" \
  && test -n "$UI_DIST_PATH" \
  && case "$UI_DIST_PATH" in /*|*..*) exit 1 ;; esac \
  && yarn install --immutable \
  && yarn build \
  && rm -rf "$UI_DIST_PATH" /workspace/ui-dist \
  && yarn workspace "$UI_WORKSPACE" build \
  && test -f "$UI_DIST_PATH/index.html" \
  && mkdir -p /workspace/ui-dist \
  && cp -R "$UI_DIST_PATH/." /workspace/ui-dist/

FROM nginx:1.27-alpine

COPY ui/dzup-ui/deploy/nginx.static.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/ui-dist/ /usr/share/nginx/html/

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
