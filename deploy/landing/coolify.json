{
  "schemaVersion": 1,
  "app": "dzup-ui-landing",
  "resourceName": "dzup-ui-landing-production",
  "environment": "production",
  "sourcePath": "ui/dzup-ui",
  "sourceRepository": "dzup-ui",
  "buildPack": "docker-compose",
  "deployMode": "remote-workspace-image",
  "composeFile": "deploy/docker-compose.coolify.yml",
  "domains": { "web": "dzup-ui-landing.dziphost.com" },
  "services": {
    "web": {
      "public": true,
      "port": 8080,
      "healthUrl": "https://dzup-ui-landing.dziphost.com/healthz",
      "remoteWorkspaceBuild": {
        "context": ".",
        "dockerfile": "ui/dzup-ui/deploy/Dockerfile.static",
        "args": {
          "UI_WORKSPACE": "@dzup-ui/landing",
          "UI_DIST_PATH": "apps/landing/dist",
          "UI_BUILD_STORYBOOK": "1"
        }
      },
      "postBuildAssertions": {
        "requiredFiles": ["/usr/share/nginx/html/index.html"],
        "nginxConfig": true
      }
    }
  },
  "build": {
    "dependencyMode": "workspace-bundle",
    "hasExternalPortalDependencies": false
  },
  "requiredEnv": [],
  "notes": ["Build from the canonical dzup-ui repository and serve the generated landing site as immutable static content."]
}
