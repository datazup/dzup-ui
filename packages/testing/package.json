{
  "name": "@dzup-ui/testing",
  "type": "module",
  "version": "0.1.0",
  "description": "DOM test-environment support and anatomy conformance for dzup-ui consumers",
  "license": "MIT",
  "sideEffects": [
    "./dist/vitest.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./security-corpus": {
      "types": "./dist/security-corpus.d.ts",
      "import": "./dist/security-corpus.js"
    }
  },
  "files": [
    "LICENSE",
    "dist",
    "security-corpus"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "yarn --cwd ../.. vitest run packages/testing/src",
    "build": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
