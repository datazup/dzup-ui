{
  "name": "@dzup-ui/core",
  "type": "module",
  "version": "0.1.0",
  "description": "Core foundational components for dzup-ui",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./styles": "./dist/core.css",
    "./buttons": {
      "types": "./dist/components/buttons/index.d.ts",
      "import": "./dist/components/buttons/index.js"
    },
    "./cards": {
      "types": "./dist/components/cards/index.d.ts",
      "import": "./dist/components/cards/index.js"
    },
    "./data": {
      "types": "./dist/components/data/index.d.ts",
      "import": "./dist/components/data/index.js"
    },
    "./feedback": {
      "types": "./dist/components/feedback/index.d.ts",
      "import": "./dist/components/feedback/index.js"
    },
    "./forms": {
      "types": "./dist/components/forms/index.d.ts",
      "import": "./dist/components/forms/index.js"
    },
    "./inputs": {
      "types": "./dist/components/inputs/index.d.ts",
      "import": "./dist/components/inputs/index.js"
    },
    "./layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js"
    },
    "./media": {
      "types": "./dist/components/media/index.d.ts",
      "import": "./dist/components/media/index.js"
    },
    "./navigation": {
      "types": "./dist/components/navigation/index.d.ts",
      "import": "./dist/components/navigation/index.js"
    },
    "./overlays": {
      "types": "./dist/components/overlays/index.d.ts",
      "import": "./dist/components/overlays/index.js"
    },
    "./typography": {
      "types": "./dist/components/typography/index.d.ts",
      "import": "./dist/components/typography/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "build": "vite build"
  },
  "peerDependencies": {
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@dzup-ui/contracts": "workspace:*",
    "@dzup-ui/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "qrcode-generator": "^2.0.4",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "0.3.1"
  },
  "devDependencies": {
    "@floating-ui/vue": "^1.1.0",
    "@vitejs/plugin-vue": "^6",
    "lucide-vue-next": "^0.477.0",
    "reka-ui": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7",
    "vue": "^3.5.13",
    "vue-tsc": "^3"
  }
}
