{
  "name": "@dzup-ui/nuxt",
  "type": "module",
  "version": "0.1.0-alpha.0",
  "description": "Nuxt module for dzup-ui — registers every component from the generated ownership table as a Nuxt auto-import",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "files": [
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "yarn --cwd ../.. vitest run packages/nuxt/src",
    "build": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "@dzup-ui/core": ">=0.1.0-alpha.0",
    "@dzup-ui/tokens": ">=0.1.0-alpha.0",
    "nuxt": ">=3.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "3.14.0"
  },
  "devDependencies": {
    "@dzup-ui/core": "workspace:*",
    "@dzup-ui/tokens": "workspace:*",
    "@nuxt/schema": "3.14.0",
    "nuxt": "3.14.0",
    "typescript": "^5.8.3"
  }
}
