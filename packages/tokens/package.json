{
  "name": "@dzup-ui/tokens",
  "type": "module",
  "version": "0.2.0",
  "description": "Design tokens for the dzup-ui component library",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./dtcg": "./dist/tokens.dtcg.json",
    "./tailwind": {
      "types": "./dist/tailwind-theme.d.ts",
      "import": "./dist/tailwind-theme.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node --import tsx src/generate.ts",
    "generate:dtcg": "node --import tsx src/generate-dtcg.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "yarn --cwd ../.. vitest run packages/tokens/src/theme-recipe.spec.ts",
    "build": "vite build && node --import tsx src/generate.ts && node --import tsx src/generate-dtcg.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^7",
    "vite-plugin-dts": "^4.5.4"
  }
}
