{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir: tooling ships as source (its exports point at ./src/*.ts,
    // there is no build step) and the DESIGN.md gate imports @dzup-ui/tokens
    // source directly, which lives outside src/.
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  // __fixtures__ holds deliberately broken inputs for the ownership scanner --
  // including a re-export of a module that does not exist, which is the case
  // proving the scanner reports an unreadable reference instead of silently
  // exporting nothing. Type-checking them would report the fixture as the bug.
  "exclude": ["node_modules", "dist", "src/**/__fixtures__/**"]
}
