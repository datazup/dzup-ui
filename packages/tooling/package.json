{
  "name": "@dzup-ui/tooling",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Validators, boundary checks, and token compliance tools for dzup-ui",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts"
    },
    "./resolution": {
      "types": "./src/resolution/dzup-resolution.ts",
      "import": "./src/resolution/dzup-resolution.ts"
    },
    "./playground": {
      "types": "./src/playground/playground-contract.ts",
      "import": "./src/playground/playground-contract.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "validate:boundaries": "tsx src/validators/import-boundary.ts",
    "validate:interaction-contract": "tsx src/validators/interaction-contract.ts",
    "validate:tokens": "tsx src/token-checks/color-lint.ts",
    "validate:exports": "tsx ../scripts/validate-exports.ts",
    "validate:bundle": "tsx ../scripts/validate-bundle.ts",
    "validate:changelog": "tsx scripts/validate-changelog.ts",
    "validate:dts": "tsx scripts/validate-dts.ts",
    "validate:peers": "tsx scripts/validate-peers.ts",
    "generate:exports": "tsx src/manifest-generator.ts",
    "design:application-plan": "tsx src/design-application-plan.ts",
    "validate:tree-shake": "tsx src/tree-shake-check.ts",
    "test:perf": "vitest run --root ../.. packages/tooling/src/perf-bench.spec.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  }
}
