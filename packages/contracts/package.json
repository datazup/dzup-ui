{
  "name": "@dzup-ui/contracts",
  "type": "module",
  "version": "0.1.0",
  "description": "Canonical public API contracts for dzup-ui components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/datazup/dzup-ui.git",
    "directory": "packages/contracts"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "VERSIONING.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "yarn --cwd ../.. vitest run packages/contracts/src",
    "build": "tsc --project tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vue": "^3.5.13"
  }
}
